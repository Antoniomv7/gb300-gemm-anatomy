# Phase 3-only version contract for gb300-gemm-anatomy (P3.1).
# All values resolved with read-only registry/Git queries on 2026-08-05.
#
# This file EXTENDS the global contract in VERSIONS.env; it never alters it.
# VERSIONS.env stays exactly as the closed, audited P1/P2 units consume it:
# scripts/aggregate_exp01_memory_paths.py and
# scripts/aggregate_exp02_umma_throughput.py parse it against a closed key
# allowlist and reject any unknown key, so no Phase 3 key may be added there.
#
# Nothing below duplicates, relaxes, or overrides a global pin: the CUDA
# toolkit version, image digest and platform, CUTLASS/CuTe DSL version and
# commit, sm_103a target, and MAX_BUILD_JOBS remain defined exclusively in
# VERSIONS.env and are unchanged by Phase 3.
#
# Simple KEY=VALUE syntax, consumed by GNU Make (`include`) and shell tooling.
# Every value is exact and non-floating. Never edit without re-resolving from
# official sources and re-auditing.

# PyTorch is an AUXILIARY dependency of NVIDIA's own CuTe DSL examples only:
# allocation, DLPack interoperability, CUDA stream access, and CPU reference
# validation. The cu130 wheel does NOT replace the pinned CUDA 13.1.0 toolkit,
# CuTe DSL v4.6.1, or the sm_103a compilation target in VERSIONS.env.
PYTORCH_VERSION=2.10.0+cu130
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
PYTORCH_CUDA_VERSION=13.0
# torch 2.10.0+cu130 requires cuda-bindings==13.0.3, so cuda-python is pinned
# to its matching 13.0.3 release rather than the 13.3.1 the CuTe DSL installer
# resolves by default. The resulting dependency graph is coherent:
# `python3 -m pip check` must report no broken requirements at image build
# time, in `make check-env`, and in `make gemm-cutedsl-p31-check`.
CUDA_PYTHON_VERSION=13.0.3
CUDA_BINDINGS_VERSION=13.0.3
# The unmodified official NVIDIA example executed by P3.1, relative to the
# CUTLASS_COMMIT checkout at /opt/cutlass (NVIDIA/cutlass v4.6.1, BSD-3-Clause).
# It is never copied, vendored, or patched into this repository.
CUTEDSL_P31_EXAMPLE_PATH=examples/python/CuTeDSL/cute/blackwell/kernel/dense_gemm/dense_gemm.py
CUTEDSL_P31_EXAMPLE_GIT_BLOB=6c6144bc88896cffb3c8c4692ca915f993c71e1d
CUTEDSL_P31_EXAMPLE_SHA256=f99bc4cc1e0aea8990e2929d7c703dfc8196d797b7c9f5a889eabcd3c4ff67ec
