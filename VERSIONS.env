# Immutable version contract for gb300-gemm-anatomy (Phase 0).
# All values resolved with read-only registry/Git queries on 2026-07-16.
# Never edit without re-resolving from official sources and re-auditing.
CUDA_VERSION=13.1.0
CUDA_IMAGE=nvidia/cuda:13.1.0-devel-ubuntu24.04
# linux/amd64 manifest digest, taken from the Docker Hub manifest list for the
# tag above (manifest-list digest: sha256:7f32ae6e575abb29f2dacf6c75fe94a262bb48dcc5196ac833ced59d9fde8107).
CUDA_IMAGE_DIGEST=sha256:0725ed044e80c230fcd54218ae3edc2855897ef7813b20868bdb53b03b99ea1c
CUDA_IMAGE_PLATFORM=linux/amd64
CUTLASS_VERSION=v4.6.1
# refs/tags/v4.6.1 is a lightweight tag in github.com/NVIDIA/cutlass; it points
# directly at this commit (peeled commit == tag target).
CUTLASS_COMMIT=e05f953a5b3d38adc240df2ff928e0421c2abba3
CUDA_ARCH=sm_103a
MAX_BUILD_JOBS=2
# --- P3.1 additions (Phase 3), resolved 2026-08-05 --------------------------
# PyTorch is an AUXILIARY dependency of NVIDIA's own CuTe DSL examples only:
# allocation, DLPack interoperability, CUDA stream access, and CPU reference
# validation. The cu130 wheel does NOT replace the pinned CUDA 13.1.0 toolkit,
# CuTe DSL v4.6.1, or the sm_103a compilation target above; none of those
# values change. Exact, non-floating pin from the official PyTorch index.
PYTORCH_VERSION=2.10.0+cu130
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
PYTORCH_CUDA_VERSION=13.0
# The unmodified official NVIDIA example executed by P3.1, relative to the
# CUTLASS_COMMIT checkout at /opt/cutlass (NVIDIA/cutlass v4.6.1, BSD-3-Clause).
# It is never copied, vendored, or patched into this repository.
CUTEDSL_P31_EXAMPLE_PATH=examples/python/CuTeDSL/cute/blackwell/kernel/dense_gemm/dense_gemm.py
CUTEDSL_P31_EXAMPLE_GIT_BLOB=6c6144bc88896cffb3c8c4692ca915f993c71e1d
CUTEDSL_P31_EXAMPLE_SHA256=f99bc4cc1e0aea8990e2929d7c703dfc8196d797b7c9f5a889eabcd3c4ff67ec
